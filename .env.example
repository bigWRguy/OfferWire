# Copy to .env and fill in. Everything here is optional except the credentials.

# Session credentials for the upstream source. Required; the run exits non-zero
# without them.
# X_AUTH_TOKEN=
# X_CT0=
# X_SESSIONS=token1:secret1,token2:secret2

# Tuning
# OFFERWIRE_REQUESTS_PER_CRED=26
# OFFERWIRE_SCROLLS=0
# OFFERWIRE_PROFILES_PER_RUN=0
# OFFERWIRE_RECENCY_HOURS=96
# OFFERWIRE_BACKFILL_DAYS=0
# OFFERWIRE_BACKFILL_SHARE=0.5
