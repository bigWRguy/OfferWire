# ---------------------------------------------------------------------------
# SEARCH CREDENTIALS — REQUIRED.
# Per-school search is the engine. Without one of these the wire is blind to any
# recruit outside the accounts you already follow, and the run fails on purpose.
# ---------------------------------------------------------------------------

# Option A — session cookies from x.com (free, uses a real account; see README risk note)
# X_AUTH_TOKEN=
# X_CT0=

# Pool several sessions to cut sweep latency. Budget scales linearly with pool size.
# Run `node scripts/coverage.mjs N` to see what N buys you.
# X_SESSIONS=authtoken1:ct01,authtoken2:ct02,authtoken3:ct03


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# OFFERWIRE_REQUESTS_PER_CRED=30
# OFFERWIRE_SCROLLS=1           # extra result pages per search job
# OFFERWIRE_PROFILES_PER_RUN=25
# OFFERWIRE_RECENCY_HOURS=96
# OFFERWIRE_BACKFILL_DAYS=0     # resumable daily slices for every FBS team
# OFFERWIRE_BACKFILL_SHARE=0.5  # fraction of search budget spent on history
