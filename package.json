{
  "name": "sandbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal scripts.",
  "scripts": {
    "wire": "node src/pipeline.js",
    "health": "node scripts/health.mjs",
    "coverage": "node scripts/coverage.mjs",
    "selftest": "node scripts/selftest.mjs",
    "fixture": "node scripts/fixture-run.mjs",
    "audit": "node scripts/audit.mjs && node scripts/replay.mjs --rejected",
